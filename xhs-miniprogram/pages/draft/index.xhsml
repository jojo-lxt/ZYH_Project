<view class="page">
  <view xhs:if="{{loading}}" class="state-card">正在加载素材...</view>
  <view xhs:elif="{{error}}" class="state-card error">{{error}}</view>

  <block xhs:else>
    <view class="preview-stage">
      <image xhs:if="{{currentImage}}" mode="aspectFill" src="{{currentImage.absoluteUrl}}" />
    </view>

    <scroll-view class="thumb-strip" scroll-x>
      <view
        xhs:for="{{draft.selectedImages}}"
        xhs:key="id"
        class="{{index === currentImageIndex ? 'thumb active' : 'thumb'}}"
        data-index="{{index}}"
        bindtap="selectImage"
      >
        <image mode="aspectFill" src="{{item.absoluteUrl}}" />
      </view>
    </scroll-view>

    <view class="result-head">
      <text>生成结果预览</text>
      <view>
        <button bindtap="copyCaption" size="mini" disabled="{{captionLoading}}">复制</button>
      </view>
    </view>

    <!-- 跳转后小红书会清空经接口带过去的 AI 文案(图片不受影响),点发布已把文案复制到剪贴板,
         引导用户到发布页长按正文粘贴补回。放在预览标题与文案卡片之间,随页面正常排版,不再悬浮叠字 -->
    <view xhs:if="{{!demo && !captionLoading}}" class="publish-hint">
      💡 跳转后请在发布页长按正文「粘贴」补上文案(点发布已自动复制)
    </view>

    <view class="caption-card">
      <view xhs:if="{{captionLoading}}" class="caption-loading">AI 文案生成中…</view>
      <block xhs:else>
        <textarea auto-height disabled value="{{draft.caption}}" />
        <view class="tag-row">
          <text xhs:for="{{draft.tags}}" xhs:key="*this" class="tag">#{{item}}</text>
        </view>
      </block>
    </view>

    <button class="secondary-action" bindtap="refreshPreview" loading="{{refreshing}}">换一批</button>

    <view class="footer">
      <!-- 正常流程:文案就绪后用小红书原生「发小红书」组件,点击即带图跳发布页;文案经接口
           会被治理清空,靠 onPublishTap 复制到剪贴板 + 用户手动粘贴补回 -->
      <post-note-button
        xhs:if="{{!demo && !captionLoading}}"
        style="width: 100%;"
        type="default"
        size="large"
        title="{{publishTitle}}"
        content="{{publishContent}}"
        media-info="{{mediaInfo}}"
        tags="{{publishTags}}"
        bindtap="onPublishTap"
        binderror="onPublishError"
      ></post-note-button>
      <!-- 示例模式:不真跳发布,点了只弹说明 -->
      <button xhs:elif="{{demo}}" class="primary" bindtap="showDemoPublishTip">
        + 发小红书
      </button>
      <!-- 文案生成中:占位禁用按钮 -->
      <button xhs:else class="primary" disabled loading="{{captionLoading}}">
        + 发小红书
      </button>
    </view>
  </block>
</view>
